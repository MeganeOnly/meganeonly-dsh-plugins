{
  "name": "dsh-manager-hub",
  "version": "0.1.3",
  "author": "MeganeOnly",
  "description": "设置页统一管理器：把 插件管理 / Skill 管理 / MCP 管理 三个独立插件聚合成一个\"管理\"入口，顶部 tab 切换（插件默认）；某管理插件停用时对应 tab 自动隐藏。数据源与宿主逻辑仍由三个老插件各自提供，本插件只做 UI 聚合。",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/MeganeOnly/meganeonly-dsh-plugins.git",
    "directory": "dsh-manager-hub"
  },
  "bugs": {
    "url": "https://github.com/MeganeOnly/meganeonly-dsh-plugins/issues"
  },
  "homepage": "https://github.com/MeganeOnly/meganeonly-dsh-plugins/tree/main/dsh-manager-hub#readme",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "manager",
    "hub",
    "settings",
    "tabs"
  ],
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "package.json"
  ],
  "scripts": {
    "build:client": "node lib/build-client.cjs",
    "verify:client": "node lib/verify-client.cjs",
    "prepare": "node lib/build-client.cjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  }
}
