{
  "name": "dsh-peak-hour-lock",
  "version": "0.3.3",
  "author": "MeganeOnly",
  "description": "北京时间高峰时段（8:50-12:00、13:50-18:00）按 provider/model 白名单拦截发送：默认仅锁 deepseek-official（避免误锁第三方转发/本地镜像/openrouter 之类的同名 DeepSeek），消息暂存保留，高峰期结束后（约2分钟）自动补发回原会话（不活跃会话自动从磁盘恢复）；输入框上方可查看/编辑/删除/立即发送暂存消息，状态横幅显示当前锁住的 provider/model。v0.3.3 起：plugin 启动时自动清理超过 staleAfterMs（默认 7 天）的陈旧暂存条目，状态 API 返回 stalePrunedAtBoot 让 UI 显示清理数量（关闭：staleAfterMs: 0）。",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/MeganeOnly/meganeonly-dsh-plugins.git",
    "directory": "peak-hour-lock"
  },
  "bugs": {
    "url": "https://github.com/MeganeOnly/meganeonly-dsh-plugins/issues"
  },
  "homepage": "https://github.com/MeganeOnly/meganeonly-dsh-plugins/tree/main/peak-hour-lock#readme",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "peak-hours",
    "scheduler",
    "message-queue",
    "cost-control"
  ],
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "package.json"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  }
}
