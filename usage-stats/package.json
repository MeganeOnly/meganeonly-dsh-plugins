{
  "name": "dsh-usage-stats",
  "version": "0.3.5",
  "author": "MeganeOnly",
  "description": "使用统计：跨会话汇总 token 用量（输入/输出/缓存/推理，模型侧精确值）、多粒度趋势（分钟/小时/日/周）、按模型分解、会话与工具排行、GitHub 风格 53 周贡献热力图、子代理消耗归并到 root main session。数据直接解码 ~/.dsh/sessions 的会话日志，增量缓存，设置页查看。",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/MeganeOnly/meganeonly-dsh-plugins.git",
    "directory": "usage-stats"
  },
  "bugs": {
    "url": "https://github.com/MeganeOnly/meganeonly-dsh-plugins/issues"
  },
  "homepage": "https://github.com/MeganeOnly/meganeonly-dsh-plugins/tree/main/usage-stats#readme",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "usage-statistics",
    "token-usage",
    "analytics",
    "dashboard"
  ],
  "type": "module",
  "main": "lib/index.js",
  "scripts": {
    "build:client": "node lib/build-client.cjs",
    "verify:client": "node lib/verify-client.cjs",
    "prepare": "node lib/build-client.cjs"
  },
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "package.json"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  }
}
