{
  "name": "dsh-plugin-manager",
  "version": "0.2.0",
  "author": "MeganeOnly",
  "description": "常驻插件管理器：在设置页列出所有非系统常驻插件（含作者署名），一键启用/停用（写入 web profile 的 cordis.patch.yml，通常热重载生效，个别需重启）。",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/MeganeOnly/meganeonly-dsh-plugins.git",
    "directory": "plugin-manager"
  },
  "bugs": {
    "url": "https://github.com/MeganeOnly/meganeonly-dsh-plugins/issues"
  },
  "homepage": "https://github.com/MeganeOnly/meganeonly-dsh-plugins/tree/main/plugin-manager#readme",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "plugin-manager",
    "cordis",
    "settings"
  ],
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "package.json"
  ],
  "dependencies": {
    "yaml": "^2.9.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  }
}
